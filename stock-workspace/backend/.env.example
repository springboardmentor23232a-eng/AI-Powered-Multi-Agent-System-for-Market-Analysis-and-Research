# PostgreSQL (recommended). If DATABASE_URL is not set, a local SQLite file is used so you can start instantly.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/stock_research
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
# Set to true when serving over HTTPS
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
