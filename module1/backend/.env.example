# Copy to .env and edit. NEVER commit the real .env file.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/stockresearch
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-change-me-change-me-change-me-please
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Set COOKIE_SECURE=true whenever the site is served over HTTPS (always in production)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:5173"]
# Return the JWT in the JSON body as well (handy for Swagger/Postman). Set false in production
# so the token is only ever reachable through the HTTP-only cookie.
EXPOSE_TOKEN_IN_BODY=true
# demo = clearly-labelled synthetic prices (works offline) | yahoo = real prices from Yahoo Finance
MARKET_DATA_PROVIDER=demo
# News for the News & Sentiment agent: demo = clearly-labelled SAMPLE headlines | yahoo = Yahoo Finance RSS (no key) | newsapi (needs NEWSAPI_KEY)
NEWS_PROVIDER=demo
NEWSAPI_KEY=
# Kaggle "Financial Statements of Major Companies (2009-2023)" CSV used by the Fundamental agent (blank = backend/data/financial_statements.csv).
# Check what was recognised with:  cd backend && python -m app.tools.check_dataset
FINANCIALS_DATASET_PATH=
# Simulated analysis time so Pending -> Processing -> Completed is visible in the UI
WORKFLOW_DELAY_SECONDS=3

# ---------------------------------------------------------------------------------------------
# "Continue with Google / Apple"  (leave blank to disable - the buttons then explain it is not set up)
# PUBLIC_BASE_URL = the address the BROWSER uses (Vite dev server locally, your https domain in production).
# Redirect URI to register at Google / Apple:  <PUBLIC_BASE_URL>/api/auth/google/callback  and  .../apple/callback
PUBLIC_BASE_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: Services ID, Team ID, Key ID and the .p8 key (write line breaks as \n). Apple requires HTTPS + a real domain.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
