import argparse, os, sys
from pathlib import Path
import pandas as pd
from sqlalchemy import create_engine
from sqlalchemy.orm import Session
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from app.database import Base
from app.models import MarketBar

def main():
    parser=argparse.ArgumentParser()
    parser.add_argument("--file",required=True)
    parser.add_argument("--symbol",required=True)
    parser.add_argument("--market",required=True,choices=["NSE","BSE","NASDAQ","NYSE"])
    args=parser.parse_args()
    path=Path(args.file)
    if not path.exists(): raise SystemExit(f"CSV not found: {path}")
    df=pd.read_csv(path)
    df.columns=[str(c).strip().lower() for c in df.columns]
    required={"date","open","high","low","close","volume"}
    if not required.issubset(df.columns): raise SystemExit(f"CSV must contain: {sorted(required)}")
    df["date"]=pd.to_datetime(df["date"],utc=True,errors="coerce")
    for c in ["open","high","low","close","volume"]: df[c]=pd.to_numeric(df[c],errors="coerce")
    df=df.dropna(subset=["date","open","high","low","close"])
    df=df.drop_duplicates(subset=["date"],keep="last")
    bad=(df.high<df.low)|(df.high<df[["open","close"]].max(axis=1))|(df.low>df[["open","close"]].min(axis=1))
    df=df.loc[~bad]
    url=os.getenv("DATABASE_URL","postgresql+psycopg://stock:stockpass@localhost:5432/stockresearch")
    engine=create_engine(url,pool_pre_ping=True); Base.metadata.create_all(engine)
    with Session(engine) as db:
        for r in df.itertuples(index=False):
            db.add(MarketBar(symbol=args.symbol.upper(),market=args.market,date=r.date.to_pydatetime(),
                             open=float(r.open),high=float(r.high),low=float(r.low),close=float(r.close),
                             volume=int(r.volume) if pd.notna(r.volume) else None,source="Kaggle dataset"))
        db.commit()
    print(f"Imported {len(df)} validated rows from {path.name} as Kaggle dataset.")
if __name__=="__main__": main()
