# Copy to .env for local development
DATABASE_URL=sqlite:///./stock_research.db
# For PostgreSQL (used automatically in docker-compose.yml):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/stock_research

SECRET_KEY=change-this-to-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
COOKIE_SECURE=false
