# ==============================================================================
# FinCrew Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to .env inside backend/:
#    cp .env.example .env
# 2. Replace the placeholder values with your local configuration.
# 3. NEVER commit your actual .env file or real secrets to Git.
# ==============================================================================

# Application Configuration
APP_NAME=FinCrew
ENV=development
DEBUG=True
PORT=8000

# PostgreSQL Database Connection
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
# Examples:
#   macOS (Postgres.app / Homebrew): postgresql+psycopg://<your_username>@localhost:5432/fincrew_db
#   Standard PostgreSQL:            postgresql+psycopg://postgres:your_password@localhost:5432/fincrew_db
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/fincrew_db

# CORS Allowed Origins (Comma-separated origins for Vite / React frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security & Authentication (Cryptographic Secret Key for JWT Signing)
# Generate a strong 32+ character key with: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_32_character_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
