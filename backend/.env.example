# ==============================================================================
# Environment Configuration - Multi-Agent Stock Research Analyst
# ==============================================================================

APP_NAME="Multi-Agent Stock Research Analyst"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=127.0.0.1

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# For PostgreSQL (PostgreSQL 18 - stock_research_db):
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/stock_research_db

# For Local Development / Testing without a PostgreSQL server running, you can use:
# DATABASE_URL=sqlite:///./market_research.db

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# JWT & Authentication Configuration
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=replace_with_a_secure_random_32_byte_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
COOKIE_SECURE=False
COOKIE_SAMESITE=lax

