# ---- Database (PostgreSQL 18) ----
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=netshield
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password

# ---- JWT / Auth ----
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS / Cookies ----
CORS_ORIGINS=http://localhost:5173
# Set to true only when serving over HTTPS
COOKIE_SECURE=false

# ---- Initial admin bootstrap (used once by scripts/create_admin.py) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@netshield.local
ADMIN_PASSWORD=change-me-strong-password
ADMIN_FULL_NAME=System Administrator
